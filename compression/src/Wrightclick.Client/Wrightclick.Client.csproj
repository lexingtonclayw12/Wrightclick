<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    A Razor class library rather than a WASM app: these types are drop-ins for
    the existing Blazor project, so they build and test without an entry point.
    Register in the host app's Program.cs:

      builder.Services.AddScoped<IPayloadCache, IndexedDbPayloadCache>();
      builder.Services.AddScoped<JobDataStore>();
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wrightclick.Compression\Wrightclick.Compression.csproj" />
  </ItemGroup>

</Project>
