# ============================================
# Wright Click Studio — Social Server Config
# Copy to .env and fill in your values
# ============================================

# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:8080

# ── META (Facebook + Instagram) ─────────────
# Get from: developers.facebook.com > Graph API Explorer
# Required permissions: pages_manage_posts, instagram_content_publish, pages_read_engagement
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_API_VERSION=v18.0

# ── TIKTOK ──────────────────────────────────
# Get from: developers.tiktok.com > Your App
# OAuth scopes needed: video.publish, video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ── EMAIL NOTIFICATIONS ──────────────────────
# Optional: get notified when a new lead submits the diagnostic
# Uses nodemailer — add smtp details or a service like Resend/SendGrid
NOTIFY_EMAIL=hello@wrightclickstudio.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
